@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap');
@import "tailwindcss";

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Playfair Display", serif;
  
  --color-brand-blue: #1E3A8A;
  --color-brand-blue-light: #3B82F6;
  --color-brand-orange: #C2410C;
  --color-bg-dark: #cbd5e1;
  --color-bg-panel: #f1f5f9;
}

@layer base {
  body {
    @apply bg-linear-to-br from-[#f8fafc] via-[#cbd5e1] to-[#94a3b8] text-slate-800 font-sans antialiased selection:bg-brand-orange/30;
  }
}

.glass {
  @apply bg-white/40 backdrop-blur-3xl border border-white/40 shadow-[0_8px_32px_0_rgba(31,38,135,0.07)];
}

.btn-gradient {
  @apply bg-linear-to-b from-[#1e40af] via-[#3b82f6] to-[#1e3a8a] text-white shadow-[0_4px_20px_-5px_rgba(30,64,175,0.4)] hover:shadow-[0_15px_30px_-5px_rgba(30,64,175,0.5)] transition-all duration-500 border-t border-white/30 relative overflow-hidden;
}

.btn-gradient::after {
  content: "";
  @apply absolute inset-0 bg-linear-to-r from-transparent via-white/20 to-transparent skew-x-[-20deg] translate-x-[-200%] transition-transform duration-[1000ms] pointer-events-none;
}

.btn-gradient:hover::after {
  @apply translate-x-[200%];
}

.btn-accent {
  @apply bg-linear-to-b from-[#f97316] via-[#ea580c] to-[#c2410c] text-white shadow-[0_4px_20px_-5px_rgba(194,65,12,0.4)] hover:shadow-[0_15px_30px_-5px_rgba(194,65,12,0.6)] transition-all duration-500 border-t border-white/30 relative overflow-hidden;
}

.btn-accent::after {
  content: "";
  @apply absolute inset-0 bg-linear-to-r from-transparent via-white/30 to-transparent skew-x-[-20deg] translate-x-[-200%] transition-transform duration-[1000ms] pointer-events-none;
}

.btn-accent:hover::after {
  @apply translate-x-[200%];
}

.markdown-body {
  @apply text-slate-800 leading-relaxed;
}

.markdown-body h1 {
  @apply font-display italic text-4xl mb-8 border-b border-slate-300 pb-8 text-center leading-tight font-black uppercase tracking-tight;
  background: linear-gradient(to bottom right, #f97316, #c2410c, #7c2d12);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.markdown-body h2 {
  @apply text-[14px] uppercase tracking-[0.4em] font-black mt-12 mb-6 flex items-center gap-4;
  background: linear-gradient(to right, #ea580c, #f97316, #c2410c);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.markdown-body h2::before {
  content: "";
  @apply w-1.5 h-6 bg-brand-blue rounded-full;
}

.markdown-body h3 {
  @apply text-[11px] uppercase tracking-[0.25em] text-slate-600 font-bold mt-10 mb-4 flex items-center gap-2;
}

.markdown-body p { @apply text-base leading-relaxed text-slate-800 mb-6; }

.markdown-body ul {
  @apply space-y-4 text-base mb-8;
}

.markdown-body li {
  @apply flex gap-4 items-start text-slate-800;
}

.markdown-body li strong {
  @apply text-slate-900 font-bold tracking-tight;
}

.markdown-body blockquote {
  @apply border-l-8 border-brand-orange pl-8 py-8 italic bg-slate-50 rounded-r-3xl text-xl text-slate-900 mb-12 shadow-sm;
}

.markdown-body table {
  @apply w-full border-collapse mb-8 text-[13px] text-left overflow-hidden rounded-2xl border border-slate-200 shadow-xl bg-white;
}

.markdown-body th {
  @apply bg-slate-100 p-4 text-slate-800 font-extrabold uppercase tracking-widest border-b border-slate-200;
}

.markdown-body td {
  @apply p-4 border-b border-slate-100 text-slate-700 align-middle;
}

.markdown-body tr:last-child td {
  @apply border-b-0;
}

.markdown-body tr:hover td {
  @apply bg-slate-50 transition-colors;
}

.markdown-body hr {
  @apply border-slate-200 my-12;
}

.markdown-body strong {
  @apply text-slate-900 font-bold;
}

::-webkit-scrollbar {
  display: none;
}

